<Project>
  <!-- Central Package Management: versões só aqui. Nos .csproj vai <PackageReference Include="X" /> sem versão. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Aspire 17: AppHost com Microsoft.NET.Sdk e pacotes explícitos (Aspire.AppHost.Sdk está obsoleto). -->
  <ItemGroup Label="Aspire (AppHost)">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.Functions" Version="17.0.0" />
  </ItemGroup>

  <ItemGroup Label="ServiceDefaults e Gateway">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="11.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="Azure Functions (isolated worker)">
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
  </ItemGroup>

  <!-- EF Core 11 só suporta .NET 11; o projeto está no .NET 10 (LTS), então fica na linha 10. -->
  <ItemGroup Label="Dados (EF Core + Postgres)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.5" />
  </ItemGroup>

  <ItemGroup Label="Validação">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <!-- xUnit v3 roda pelo Microsoft.Testing.Platform (global.json → test.runner); não usa VSTest. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>
</Project>
