{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.js\"", "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-timer.js\"", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.js\"", "timeout": 10, "onFailure": "block" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/layer-guard.js\"", "timeout": 10, "onFailure": "block" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/contracts-guard.js\"", "timeout": 10, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/dangerous-commands.js\"", "timeout": 15, "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/track-changes.js\"", "timeout": 5 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-cs.js\"", "timeout": 45, "statusMessage": "Formatando C#" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-reminder.js\"", "timeout": 10 },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/adr-reminder.js\"", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/build-test-on-stop.js\"", "timeout": 600, "statusMessage": "Build e testes dos serviços alterados" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.js\"", "timeout": 660, "async": true }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.js\"", "timeout": 10, "async": true }
        ]
      }
    ]
  }
}
